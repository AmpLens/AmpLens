# Copy to webservice.env and fill in. The systemd unit loads it as its EnvironmentFile,
# or run `set -a; . webservice.env; set +a` before `python -m ampzip.webservice`.

# --- the bind address, where cloudflared connects on the same host ---
WEBSVC_HOST=127.0.0.1
WEBSVC_PORT=8000

# --- the auth mode, cloudflare for Access, basic for HTTP Basic, dev for localhost ---
WEBSVC_AUTH_MODE=basic

# === auth_mode=cloudflare, once Zero Trust Access is active ===
# CF_ACCESS_TEAM_DOMAIN=YOURTEAM.cloudflareaccess.com   # from Zero Trust Settings
# CF_ACCESS_AUD=PUT_THE_LONG_AUD_HEX_HERE               # the AUD tag on the Access app's Overview
# WEBSVC_EMAIL_WHITELIST=alice@example.org,bob@example.edu   # a second check besides Access

# === auth_mode=basic, HTTP Basic while Access is unavailable ===
# Generate each entry with:  python -m ampzip.webservice.hashpw <email> --gen
# then comma-join the printed `email:hash` lines here. Use long random secrets.
WEBSVC_BASIC_CREDS=alice@x.com:pbkdf2_sha256$200000$SALT$HASH,bob@x.com:pbkdf2_sha256$200000$SALT$HASH
# Lock out an IP after N failed logins within the window.
WEBSVC_BASIC_MAX_FAILS=8
WEBSVC_BASIC_FAIL_WINDOW_S=300

# --- load limits, tuned to the machine, with conservative defaults ---
WEBSVC_MAX_CONCURRENT=4
WEBSVC_MAX_QUEUE=32
# Job waiting time limit, including time in the job queue. For N selected GBFS
# backends, estimate ceil(N / WEBSVC_MAX_PARALLEL_ALGOS) *
# (WEBSVC_MAX_GBFS_MAX_SECONDS + WEBSVC_ALGO_GRACE_S). Five backends with four
# workers give 2 * (120 + 30) = 300 s, or 1260 s at a 600 s GBFS limit. Allow
# additional time for queueing and work outside the search loop.
WEBSVC_JOB_TIMEOUT_S=1400
# WEBSVC_MAX_GBFS_MAX_SECONDS caps the requested GBFS search time.
# WEBSVC_MAX_GBFS_MAX_APPS separately caps the move budget.
# WEBSVC_MAX_SAMPLE_TIMEOUT applies to SFT and CDS. The page reads the GBFS time
# and move limits from /api/limits. When raising WEBSVC_MAX_GBFS_MAX_SECONDS,
# also adjust WEBSVC_JOB_TIMEOUT_S to allow time for all requested backends.
WEBSVC_MAX_GBFS_MAX_SECONDS=120
WEBSVC_MAX_GBFS_MAX_APPS=200000
# Worker threads a request may ask for inside one search. 1 keeps a shared machine fair.
WEBSVC_MAX_GBFS_THREADS=1
# The limits on the gbfs_e and gbfs_f split cap and the gbfs_c cancel cap.
WEBSVC_MAX_GBFS_SPLIT_MAX_TERMS=1000
WEBSVC_MAX_GBFS_C_CANCEL_MAX_TERMS=5000
# The grace on top of a backend's own budget before the parallel collector stops waiting,
# and the bound on the sympy post-processing of a result in the helper process.
WEBSVC_ALGO_GRACE_S=30
WEBSVC_POST_TIMEOUT_S=30
WEBSVC_RATE_PER_MIN=20
# Input limits, shared with the CLI's --max-* flags and listed in docs/LIMITS.md. Parsing runs in the
# request thread, so a public deployment keeps the length well below the CLI default of 32000.
WEBSVC_MAX_INPUT_CHARS=8000
WEBSVC_MAX_INT_DIGITS=6
WEBSVC_MAX_EXPONENT=100
WEBSVC_MAX_POWER_NESTING=0
WEBSVC_MAX_NESTING_DEPTH=50
WEBSVC_MAX_NUMBER_DIGITS=1000
# The bound on concurrent in-thread atomize() and validate(), so a burst of large inputs
# cannot freeze the whole service. Excess submits get 503 after the acquire timeout. Keep it
# well under 40.
WEBSVC_ATOMIZE_CONCURRENCY=6
WEBSVC_ATOMIZE_ACQUIRE_TIMEOUT_S=20

# --- Never set this in production. It disables auth, for localhost development only. ---
# WEBSVC_DEV_ALLOW_NO_AUTH=1
